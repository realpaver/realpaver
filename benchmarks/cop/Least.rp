Variables
  x2 in [-1.e8,1.e8],
  x3 in [-1.e8,1.e8],
  x4 in [ -5, 5],
  r1 in [-1000,1000],
  r2 in [-1000,1000],
  r3 in [-1000,1000],
  r4 in [-1000,1000],
  r5 in [-1000,1000],
  r6 in [-1000,1000];

Min r1^2 + r2^2 + r3^2 + r4^2 + r5^2 + r6^2;

Constraints
  r1 == (127 + (-x3*exp(-5*x4)) - x2),
  r2 == (151 + (-x3*exp(-3*x4)) - x2),
  r3 == (379 + (-x3*exp(-x4)) - x2),
  r4 == (421 + (-x3*exp(5*x4)) - x2),
  r5 == (460 + (-x3*exp(3*x4)) - x2),
  r6 == (426 + (-x3*exp(x4)) - x2);

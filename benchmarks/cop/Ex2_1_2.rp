# COCONUT Library

Variables
x1 in [0, 1],
x2 in [0, 1],
x3 in [0, 1],
x4 in [0, 1],
x5 in [0, 1],
x6 in [0, 1.0e8];

#Minimize (-0.5*(x1*x1 + x2*x2 + x3*x3 + x4*x4 + x5*x5)) - 10.5*x1 - 7.5*x2 - 3.5*x3 - 2.5*x4 - 1.5*x5 - 10*x6;

Minimize - 0.5*x1^2 - 0.5*x2^2 - 0.5*x3^2 - 0.5*x4^2 - 0.5*x5^2
         - 10.5*x1 - 7.5*x2 - 3.5*x3 - 2.5*x4 - 1.5*x5 - 10*x6;

Constraints
6*x1 + 3*x2 + 3*x3 + 2*x4 + x5 <= 6.5,
10*x1 + 10*x3 + x6 <= 20;

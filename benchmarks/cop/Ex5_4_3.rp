# COCONUT Library

Variables
   x1 in [10, 350],
   x2 in [10, 350],
   x3 in [10, 200],
   x4 in [10, 200],
   x5 in [0, 10],
   x6 in [0, 10],
   x7 in [0, 10],
   x8 in [0, 10],
   x9 in [0, 10],
   x10 in [0, 10],
   x11 in [0, 10],
   x12 in [0, 10],
   x13 in [150, 310],
   x14 in [150, 310],
   x15 in [150, 310],
   x16 in [150, 310];

Minimize 1300*(1000/(0.0333333333333333*x1*x2 + 0.166666666666667*x1 +
              0.166666666666667*x2))^0.6 + 1300*(600/(0.0333333333333333*x3*x4
               + 0.166666666666667*x3 + 0.166666666666667*x4))^0.6;

Constraints
x5 + x9 == 10,
x5 - x6 + x11 == 0,
x7 + x9 - x10 == 0,
- x6 + x7 + x8 == 0,
- x10 + x11 + x12 == 0,
x16*x11 - x13*x6 + 150*x5 == 0,
x15*x7 - x14*x10 + 150*x9 == 0,
x6*x15 - x6*x13 == 1000,
x10*x16 - x10*x14 == 600,
x1 + x15 == 500,
x2 + x13 == 250,
x3 + x16 == 350,
x4 + x14 == 200;

    x8 + x9 + x10 + x11 >= 0,

    x9 + x10 + x11 >= 0,

    x10 + x11 >= 0,

    x11 >= 0,

  - x1 + x2 + x3 + x4 + x5 + x6 + x7 + x8 + x9 + x10 + x11 == 0;

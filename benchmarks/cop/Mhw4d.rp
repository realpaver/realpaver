# BARON solver

Variables
x2 in [-1.0e8, 1.0e8],
x3 in [-1.0e8, 1.0e8],
x4 in [-1.0e8, 1.0e8],
x5 in [-1.0e8, 1.0e8],
x6 in [-1.0e8, 1.0e8];

Minimize (x2 - 1)^2 + (x2 - x3)^2 + (x3 - x4)^3 + (x4 - x5)^4 + (x5 - x6)^4;

Constraints
x3^2 + x4^3 + x2 == 6.24264068711929,
- x4^2 + x3 + x5 == 0.82842712474619,
x2*x6 == 2;

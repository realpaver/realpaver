# COCONUT Library

Variables
x2 in [-1.0e8, 1.0e8],
x3 in [0, 1.0e8],
x4 in [0, 1.0e8],
x5 in [0, 1.0e8],
x6 in [0, 200],
x7 in [0, 200],
x8 in [0, 200],
x9 in [0, 200];

Minimize (0.5*x4 - 1)*(x4 - 2) + (0.5*x5 - 1)*(x5 - 2);

Constraints

- x3 + x4 + x5 == 0,

- x4 + x6 == 0,

- x5 + x7 == 0,

x6*x8 == 0,

x7*x9 == 0,

x2 + x4 - x8 == 0,

x2 - x9 == -1;

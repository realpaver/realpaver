# COCONUT Library

Variables
   x1 in [-5, 5],
   x2 in [-5, 5],
   x3 in [-1.0e1, 1.0e1];

Minimize x3;

Constraints
2*x2^2 + 4*x1*x2 - 42*x1 + 4*x1^3 - x3 <= 14,
(-2*x2^2) - 4*x1*x2 + 42*x1 - 4*x1^3 - x3 <= -14,
2*x1^2 + 4*x1*x2 - 26*x2 + 4*x2^3 - x3 <= 22,
(-2*x1^2) - 4*x1*x2 + 26*x2 - 4*x2^3 - x3 <= -22;

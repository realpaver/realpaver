# COCONUT Library

Variables
x1 in [0, 1],
x2 in [0, 1],
x3 in [0, 1],
x4 in [0, 1],
x5 in [1.0e-5, 16],
x6 in [1.0e-5, 16];

Min - x4;

Constraints

0.09755988*x1*x5 + x1 == 1,

0.0965842812*x2*x6 + x2 - x1 == 0,

0.0391908*x3*x5 + x3 + x1 == 1,

0.03527172*x4*x6 + x4 - x1 + x2 - x3 == 0,

x5^0.5 + x6^0.5 <= 4;

# BARON solver

Variables
  x1 in [0, 20],
  x2 in [0, 20],
  x3 in [0, 20],
  x4 in [0, 20],
  x5 in [0, 20],
  x6 in [0, 20],
  x7 in [0, 20],
  x8 in [0, 20],
  x9 in [0, 20],
  x10 in [0, 20];

Minimize x1*x6 + 2*x1 + 3*x6 + x2*x7 - 4*x2 - x7 + x3*x8 + 8*x3 - 2*x8 +
                x4*x9 + 4*x4 - 4*x9 + x5*x10 + 9*x5 + 5*x10;

Constraints

- 8*x1 - 6*x3 + 7*x4 - 7*x5 <= 1,

- 6*x1 + 2*x2 - 3*x3 + 9*x4 - 3*x5 <= 3,

  6*x1 - 7*x3 - 8*x4 + 2*x5 <= 5,

- x1 + x2 - 8*x3 - 7*x4 - 5*x5 <= 4,

  4*x1 - 7*x2 + 4*x3 + 5*x4 + x5 <= 0,

  5*x7 - 4*x8 + 9*x9 - 7*x10 <= 0,

  7*x6 + 4*x7 + 3*x8 + 7*x9 + 5*x10 <= 7,

  6*x6 + x7 - 8*x8 + 8*x9 <= 3,

- 3*x6 + 2*x7 + 7*x8 + x10 <= 6,

- 2*x6 - 3*x7 + 8*x8 + 5*x9 - 2*x10 <= 2;

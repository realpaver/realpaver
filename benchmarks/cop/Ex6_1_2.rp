# COCONUT Library

Variables
   x2 in [1.0e-6, 1],
   x3 in [1.0e-6, 1],
   x4 in [0, 1.0e8],
   x5 in [0, 1.0e8];

Minimize x2*(0.06391 + log(x2)) + x3*(log(x3) - 0.02875) +
         0.925356626778358*x2*x5 + 0.746014540096753*x3*x4;

Constraints
   x4*(x2 + 0.159040857374844*x3) - x2 == 0,
-  x5*(0.307941026821595*x2 + x3) - x3 == 0,
   x2 + x3 == 1;

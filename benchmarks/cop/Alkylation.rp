# BARON solver

Variables
x1 in [1.0e-6, 2000],
x2 in [1.0e-6, 16000],
x3 in [1.0e-6, 120],
x4 in [1.0e-6, 5000],
x5 in [1.0e-6, 2000],
x6 in [85, 93],
x7 in [90, 95],
x8 in [3, 12],
x9 in [0.01, 4],
x10 in [145, 162];

Maximize 0.063*x4*x7 - 5.04*x1 - 0.035*x2 - 10*x3 - 3.36*x5;

Constraints

    x1 - 1.22*x4 + x5 == 0,

 -98000*x3/(x4*x9 + 1000*x3) + x6 == 0,

 -(x2 + x5)/x1 + x8 == 0,

 (1.12 + 0.13167*x8 - 0.00667*x8^2)*x1 - 0.99*x4 >= 0,

 -(1.12 + 0.13167*x8 - 0.00667*x8^2)*x1 + 1.01010101010101*x4 >= 0,

 1.098*x8 - 0.038*x8^2 + 0.325*x6 - 0.99*x7 >= -57.425,

 -(1.098*x8 - 0.038*x8^2) - 0.325*x6 + 1.01010101010101*x7 >= 57.425,

  - 0.9*x9 - 0.222*x10 >= -35.82,

    1.11111111111111*x9 + 0.222*x10 >= 35.82,

    3*x7 - 0.99*x10 >= 133,

  - 3*x7 + 1.01010101010101*x10 >= -133;

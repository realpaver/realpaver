# COCONUT Library

Variables
x1 in [0, 1.0e8],
x2 in [0, 1.0e8],
x3 in [0, 1.0e8],
x4 in [0, 1.0e8],
x5 in [0, 1.0e8],
x6 in [0, 1.0e8],
x7 in [0, 1.0e8],
x8 in [0, 1.0e8],
x9 in [0, 1.0e8],
x10 in [0, 1.0e8],
x11 in [0, 1.0e8],
x12 in [0, 1.0e8],
x13 in [0, 1.0e8],
x14 in [0, 1.0e8],
x15 in [0, 1.0e8];

Minimize - 2*x2 + x3 + 0.5*x4;

Constraints

x2 + x3 <= 2,

- 2*x2 + x4 - x5 + x6 == -2.5,

x2 - 3*x3 + x5 + x7 == 2,

- x4 + x8 == 0,

- x5 + x9 == 0,


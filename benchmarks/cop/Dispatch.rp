# BARON solver

Variables
x1 in [50, 200],
x2 in [37.5, 150],
x3 in [180, 180],
x4 in [-1.0e8, 1.0e8];

Minimize 0.00533*x1^2 + 11.669*x1 + 0.00889*x2^2 + 10.333*x2 + 0.00741*x3^
              2 + 10.833*x3 + 653.1;

Constraints
-(0.01*(0.0676*x1*x1 + 0.00953*x1*x2 - 0.00507*x1*x3 + 0.00953*x2*x1 +
    0.0521*x2*x2 + 0.00901*x2*x3 - 0.00507*x3*x1 + 0.00901*x3*x2 + 0.0294*x3*x3
    ) - 0.000766*x1 - 3.42e-5*x2 + 0.000189*x3) + x4 == 0.040357,

x1 + x2 + x3 - x4 >= 210;

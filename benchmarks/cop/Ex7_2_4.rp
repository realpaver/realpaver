# COCONUT Library

Variables
   x1 in [0.1, 10],
   x2 in [0.1, 10],
   x3 in [0.1, 10],
   x4 in [0.1, 10],
   x5 in [0.1, 10],
   x6 in [0.1, 10],
   x7 in [0.1, 10],
   x8 in [0.1, 10];

Minimize 0.4*x1^0.67/x7^0.67 + 0.4*x2^0.67/x8^0.67 - x1 - x2 + 10;

Constraints
   0.0588*x5*x7 + 0.1*x1 <= 1,
   0.0588*x6*x8 + 0.1*x1 + 0.1*x2 <= 1,
   4*x3/x5 + 2/(x3^0.71*x5) + 0.0588*x7/x3^1.3 <= 1,
   4*x4/x6 + 2/(x4^0.71*x6) + 0.0588*x4^1.3*x8 <= 1;

# COCONUT Library

Variables
x1 in [-1.0e8, 1.0e8],
x3 in [0, 8],
x4 in [0, 1.0e8],
x5 in [0, 1.0e8],
x6 in [0, 1.0e8],
x7 in [0, 1.0e8],
x8 in [0, 1.0e8],
x9 in [0, 1.0e8];

Minimize (x3 - 3)^2 + (x1 - 2)^2;

Constraints

x1 - 2*x3 + x4 == 1,

- 2*x1 + x3 + x5 == 2,

2*x1 + x3 + x6 == 14,

x4*x7 == 0,

x5*x8 == 0,

x6*x9 == 0,

2*x1 + x7 - 2*x8 + 2*x9 == 10;

# COCONUT Library


Variables
x2 in [0, 1.0e8],
x3 in [0, 1.0e8],
x4 in [0, 20],
x5 in [0, 20],
x6 in [0, 20],
x7 in [0, 20],
x8 in [0, 20],
x9 in [0, 20],
x10 in [0, 20],
x11 in [0, 20];

Minimize x2^2 + (x3 - 10)^2;

Constraints

x2 <= 15,

- x2 + x3 <= 0,

- x2 <= 0,

x2 + x3 + x4 == 20,

- x3 + x5  == 0,

x3 + x6 == 20,

x4*x8  == 0,

x5*x9  == 0,

x6*x10  == 0,

x7*x11  == 0,

2*x2 + 4*x3 + x8 - x9 + x10 == 60;

# COCONUT Library

Variables
x2 in [1.0e-12, 1.0e8],
x3 in [1.0e-12, 1.0e8],
x4 in [-1.0e8, 1.0e8],
x5 in [-1.0e8, 1.0e8],
x6 in [-1.0e8, 1.0e8],

aux1 in [1.0e-12, 1.0e8],
aux2 in [1.0e-12, 1.0e8];

Minimize x2*log(x2) + x3*log(x3) - log(aux1) + x4 - x5*log(aux2)/x6 +
         0.362259780811985*x2 + 3.27527428318836*x3 - 1;

Constraints

x4^3 - x4^2 + (-x6^2 - x6 + x5)*x4 - x5*x6 == 0,

- (0.352565*x2*x2 + 0.844083*x2*x3 + 0.844083*x3*x2 + 2.14335*x3*x3) + x5 == 0,

- 0.12932*x2 - 0.271567*x3 + x6 == 0,

aux1 == x4 - x6,

aux2 == 1 + x6/x4,

x2 + x3 == 1;

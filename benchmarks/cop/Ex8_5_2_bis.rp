# COCONUT Library


Variables
x2 in [1.0e-12, 1.0e8],
x3 in [1.0e-12, 1.0e8],
x4 in [1.0e-12, 1.0e8],
x5 in [0, 1.0e8],
x6 in [-1.0e8, 1.0e8],
x7 in [-1.0e8, 1.0e8],
aux in [1.0e-12, 1.0e8];

Minimize x2*log(x2) + x3*log(x3) + x4*log(x4) + x7/aux - log(aux) - 2*x6/x5 +
         0.585616681390832*x2 + 3.53797016206289*x3 + 2.18345516206289*x4;

Constraints

x5^3 - (1 + x7)*x5^2 + x6*x5 - x6*x7 == 0,

- (0.37943*x2^2 + 0.75885*x2*x3 + 0.48991*x2*x4 + 0.75885*x3*x2 + 0.8836*x3^2 + 0.23612*x3*x4 + 0.48991*x4*x2 + 0.23612*x4*x3 + 0.63263*x4^2) + x6 == 0,

- 0.14998*x2 - 0.14998*x3 - 0.14998*x4 + x7 == 0,

x2 + x3 + x4 == 1,

aux == x5 - x7;

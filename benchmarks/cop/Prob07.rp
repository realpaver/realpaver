# BARON solver

Variables
x1 in [0, 1.0e8],
x2 in [0, 1.0e8],
x3 in [0, 1.0e8],
x4 in [100, 1.0e8],
x5 in [100, 1.0e8],
x6 in [100, 1.0e8],
x7 in [300, 1.0e8],
x8 in [300, 1.0e8],
x9 in [300, 1.0e8],
x10 in [300, 1.0e8],
x11 in [300, 1.0e8],
x12 in [5, 1.0e8],
x13 in [5, 1.0e8],
x14 in [5, 1.0e8];

Minimize 592*x1^0.65 + 582*x2^0.39 + 1200*x3^0.52 + 370*x7^0.22 + 250*x8^0.4 + 210*
    x9^0.62 + 250*x10^0.4 + 200*x11^0.83;

Constraints

    x1 - 1.2*x4 >= 0,

    x1 - 1.5*x5 >= 0,

    x1 - 1.1*x6 >= 0,

    x2 - 1.4*x4 >= 0,

    x2 - 1.2*x6 >= 0,

    x3 - x4 >= 0,

    x3 - x5 >= 0,

    x3 - x6 >= 0,

    x8 - x9 <= 0,

    x10 - x11 <= 0,

    x8 - x11 <= 0,

  - x8 + x9 == 0,

 400000*x12/x4 + 300000*x13/x5 + 100000*x14/x6 <= 8000,

 1.2*x4/x7 - x12 <= 0,

 1.2*x4/x8 - x12 <= 0,

 1.2*x4/x9 - x12 <= 0,

 1.4*x4/x10 - x12 <= 0,

 1.4*x4/x11 - x12 <= 0,

 1.5*x5/x7 - x13 <= 0,

 1.5*x5/x8 - x13 <= 0,

 1.5*x5/x9 - x13 <= 0,

 1.5*x5/x11 - x13 <= 0,

 1.1*x6/x7 - x14 <= 0,

 1.1*x6/x8 - x14 <= 0,

 1.1*x6/x9 - x14 <= 0,

 1.2*x6/x10 - x14 <= 0,

 1.2*x6/x11 - x14 <= 0,

 1.2*x4/x7 + 1.2*x4/x8 - x12 <= -3,

 1.2*x4/x9 + 1.4*x4/x10 - x12 <= -1,

 1.4*x4/x11 - x12 <= -4,

 1.5*x5/x7 + 1.5*x5/x8 - x13 <= -6,

 1.5*x5/x11 - x13 <= -8,

 1.1*x6/x7 + 1.1*x6/x8 - x14 <= -2,

 1.1*x6/x9 + 1.2*x6/x10 - x14 <= -2,

 1.2*x6/x11 - x14 <= -4;

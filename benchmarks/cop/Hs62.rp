# BARON solver

Variables
x2 in [0, 1.0e8],
x3 in [0, 1.0e8],
x4 in [0, 1.0e8];

Minimize -32.174*(255*log((0.03 + x2 + x3 + x4)/(0.03 + 0.09*x2 + x3 + x4)) +
                  280*log((0.03 + x3 + x4)/(0.03 + 0.07*x3 + x4)) +
                  290*log((0.03 + x4)/(0.03 + 0.13*x4)));

Constraints
#20*(-1 + x2 + x3 + x4)^2 == 0;

-1 + x2 + x3 + x4 == 0;

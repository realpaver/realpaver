# COCONUT Library

Variables
   x2 in [1.0e-7, 0.5],
   x3 in [1.0e-7, 0.5],
   x4' in [1.0e-7, 0.5],
   x5 in [1.0e-7, 0.5],
   x6 in [0, 1.0e8],
   x7 in [0, 1.0e8],
   x8 in [0, 1.0e8],
   x9 in [0, 1.0e8];

Minimize x2*(log(x2) - log(x2 + x4)) + x4*(log(x4) - log(x2 + x4)) + x3*(
              log(x3) - log(x3 + x5)) + x5*(log(x5) - log(x3 + x5)) +
              0.925356626778358*x2*x8 + 0.746014540096753*x4*x6 +
              0.925356626778358*x3*x9 + 0.746014540096753*x5*x7;

Constraints
   x6*(x2 + 0.159040857374844*x4) - x2 == 0,
   x7*(x3 + 0.159040857374844*x5) - x3 == 0,
   x8*(0.307941026821595*x2 + x4) - x4 == 0,
   x9*(0.307941026821595*x3 + x5) - x5 == 0,
   x2 + x3 == 0.5,
   x4 + x5 == 0.5;

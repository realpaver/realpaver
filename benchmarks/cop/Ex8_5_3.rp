# COCONUT Library

Variables
x2 in [0, 1.0e8],
x3 in [0, 1.0e8],
x4 in [0, 1.0e8],
x5 in [-1.0e8, 1.0e8],
x6 in [0, 1.0e8];

Minimize x2*log(x2) + x3*log(x3) - log(x4 - x6) + x4 - x5*log(1 + x6/x4)/x6 +
         5.0464317551216*x2 + 0.366877055769689*x3 - 1;

Constraints

x4^3 - x4^2 + (-x6^2 - x6 + x5)*x4 - x5*x6 == 0,

- (1.04633*x2^2 + 0.579822*x2*x3 + 0.579822*x3*x2 + 0.379615*x3^2) + x5 == 0,

- 0.0771517*x2 - 0.0765784*x3 + x6 == 0,

x2 + x3 == 1,

x4 - x6 >= 0,

x2 >= 0.05;
